# Spectrum credentials (from your project Settings on the Photon dashboard — https://app.photon.codes).
# Required for the iMessage provider. Omit both to run terminal-only (no creds needed).
PROJECT_ID=
PROJECT_SECRET=

# Sawa web app base URL. Required for reads + the SEARCH command (/search, "sawa <topic>").
# Reads hit the app's PUBLIC GET endpoints (${SAWA_API_BASE_URL}/api/predictions*) — no DB key,
# no JWT (the private-market guard is enforced server-side). See docs/BETTING_BOT_PLAN.md §6 (Option C).
SAWA_API_BASE_URL=https://sawapredictions.com

# Template for tappable Sawa market links + richlink cards. The live market page is /predictions/{id}.
SAWA_MARKET_URL_TEMPLATE=https://sawapredictions.com/predictions/{id}

# The name the bot answers to for group mention-gating (default: sawa). In a group it only replies
# when hailed ("sawa <topic>" / "@sawa …") or via a slash command; in a DM it always replies.
SAWA_BOT_NAME=sawa

# Conversational reply tone. Default (unset/0): factual single-market replies ("Brazil at 59% on Sawa").
# Set to 1 to append a brief editorial flourish ("— heavy favorite." / "— too close to call.") — folk
# style. The flourish is deliberately mild + category-blind; review brand fit before enabling broadly.
# SAWA_FOLK_TONE=1

# Intent parser — Gemini Flash-Lite via the OpenAI-compatible API. OPTIONAL: without a key the bot
# falls back to a deterministic regex gate (search still works for explicit phrasings). The model
# + base URL are env-overridable (defaults shown). Get a key at https://aistudio.google.com/apikey.
INTENT_LLM_API_KEY=
INTENT_LLM_MODEL=gemini-3.1-flash-lite
INTENT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# pmxt — cross-venue (Kalshi/Polymarket) read-only enrichment API. REST base: https://api.pmxt.dev
# (catalog/read host only — never the trade host). OPTIONAL: without a key, search returns Sawa-only.
# Free tier: 25,000 credits/month (1 REST call = 1 credit). Rate limit: 60 req/min. Key prefix pmxt_live_.
# Get a key at https://pmxt.dev/dashboard. Betting/trading stays on Sawa — pmxt is read-only enrichment.
PMXT_API_KEY=
# Optional REST base override (defaults to https://api.pmxt.dev).
# PMXT_API_BASE_URL=https://api.pmxt.dev
# Builder mode flag (informational; this client is GET-only and never trades).
PMXT_BUILDER_MODE=true

# Reserved (NOT used by SEARCH; for the later betting/analytics phases). The web app's BOT_SECRET —
# a master credential. Leave unset for the read-only search bot.
# SAWA_BOT_SECRET=
